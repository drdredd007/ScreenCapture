<Window x:Class="Moments.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Moments · Capture Studio" Width="1090" Height="750" MinWidth="850" MinHeight="590" WindowStartupLocation="CenterScreen">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <Border Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="16,26,16,18"><DockPanel>
 <StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="3,0,0,44"><Border Background="{StaticResource Mint}" CornerRadius="8" Width="32" Height="32"><Path Data="M 1,15 L 5,3 9,12 13,2 17,11" Stroke="#1C2A17" StrokeThickness="2.6" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Moments" FontSize="23" FontWeight="Bold" Margin="9,0,0,2"/></StackPanel>
 <TextBlock Text="STUDIO" Style="{StaticResource Sub}" FontSize="10" Margin="12,0,0,8"/>
 <Button x:Name="CaptureNav" Style="{StaticResource Nav}" Content="◉     Capture" Click="NavClick" Tag="0"/><Button x:Name="LibraryNav" Style="{StaticResource Nav}" Content="▤     Library" Click="NavClick" Tag="1"/><Button x:Name="AssemblyNav" Style="{StaticResource Nav}" Content="▧     Video Editor" Click="AssemblyClick"/><Button x:Name="SettingsNav" Style="{StaticResource Nav}" Content="⚙     Settings" Click="NavClick" Tag="2"/>
 </StackPanel><StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><Border Height="1" Background="{StaticResource Line}" Margin="4,0,4,12"/><TextBlock x:Name="DiskLabel" Style="{StaticResource Sub}" FontSize="12" Margin="5,0"/><Button Content="Minimize to tray" Click="HideClick" Style="{StaticResource Nav}" FontSize="12"/></StackPanel></DockPanel></Border>
 <Grid Grid.Column="1" Margin="30,22,30,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid Margin="0,0,0,18"><StackPanel><TextBlock Style="{StaticResource Kicker}" Text="MOMENTS   /   DESKTOP STUDIO"/><TextBlock x:Name="PageTitle" Text="Capture" FontSize="34" FontWeight="SemiBold"/></StackPanel><Border Background="#23352B" CornerRadius="12" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="StateText" Text="●  Idle" Foreground="#B8E8AA" FontSize="12"/></Border></Grid>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid>
 <StackPanel x:Name="CapturePage">
 <Border Style="{StaticResource Card}" Background="#212E2B" BorderBrush="#3B5146" Padding="22"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Kicker}" Text="01    /    SOURCE"/><TextBlock x:Name="SourceHeading" Text="Screen recording" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,3"/><TextBlock x:Name="SourceDescription" Style="{StaticResource Sub}" Text="Choose a display to record."/></StackPanel><Viewbox Grid.Column="1" Width="74" Height="58" HorizontalAlignment="Right"><Canvas Width="70" Height="52"><Rectangle Canvas.Left="2" Canvas.Top="2" Width="66" Height="40" RadiusX="5" RadiusY="5" Stroke="#93BA99" StrokeThickness="2"/><Path Data="M 28,42 L 28,48 M 42,42 L 42,48 M 21,49 L 49,49" Stroke="#93BA99" StrokeThickness="2"/><Ellipse Canvas.Left="52" Canvas.Top="9" Width="7" Height="7" Fill="#AFF288"/></Canvas></Viewbox></Grid></Border>
 <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel>
 <WrapPanel x:Name="ModePanel"><Button x:Name="ScreenButton" Content="Screen" Tag="0" Click="ModeClick"/><Button x:Name="WindowButton" Content="Window" Tag="1" Click="ModeClick"/><Button x:Name="RegionButton" Content="Region" Tag="2" Click="ModeClick"/></WrapPanel>
 <DockPanel Margin="0,14,0,0"><Button DockPanel.Dock="Right" x:Name="RefreshTargets" Content="↻" ToolTip="Refresh sources" Click="RefreshClick" Margin="8,0,0,0"/><ComboBox x:Name="Targets" SelectionChanged="TargetChanged"/></DockPanel>
 <StackPanel x:Name="RegionRow" Visibility="Collapsed" Orientation="Horizontal" Margin="0,9,0,0"><Button Content="Select region" Click="RegionClick"/><TextBlock x:Name="RegionLabel" Style="{StaticResource Sub}"/></StackPanel>
 <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Style="{StaticResource Sub}" Text="Recording profile" FontSize="12"/><ComboBox x:Name="Quality" Margin="0,4,12,0" SelectionChanged="SettingsChanged"/></StackPanel><Button Grid.Column="1" x:Name="RecordButton" Content="●   Start recording" Style="{StaticResource Accent}" Margin="0,14,0,0" Click="RecordClick"/></Grid>
 </StackPanel></Border>
 <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Style="{StaticResource Kicker}" Text="02    /    GAME REPLAYS"/><TextBlock x:Name="ReplayTitle" Style="{StaticResource H2}" Margin="0,5,0,3"/><TextBlock x:Name="ReplayHint" Style="{StaticResource Sub}"/><TextBlock x:Name="AutoSaveStatus" Style="{StaticResource Sub}" Foreground="#B7F59B" Margin="0,6,0,0" TextWrapping="Wrap"/><WrapPanel Margin="0,12,0,0"><Button x:Name="SaveReplayButton" Content="Save replay" IsEnabled="False" Click="ReplayClick"/><Button Content="Choose games" Click="GamesClick"/></WrapPanel></StackPanel></Border>
 </StackPanel>
 <StackPanel x:Name="LibraryPage" Visibility="Collapsed"><DockPanel Margin="0,0,0,14"><Button Content="Open recordings folder ↗" DockPanel.Dock="Right" Click="OpenFolder" Margin="8,0,0,0"/><TextBox x:Name="Search" ToolTip="Search by name or date" TextChanged="SearchChanged"/></DockPanel><DockPanel Margin="0,0,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ListViewButton" Content="☷  List" Tag="list" Click="LibraryViewClick" ToolTip="Compact list"/><Button x:Name="TilesViewButton" Content="▦  Tiles" Tag="tiles" Click="LibraryViewClick" ToolTip="Large preview tiles"/></StackPanel><TextBlock x:Name="LibraryCount" Style="{StaticResource Sub}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel><StackPanel x:Name="ClipList" SizeChanged="LibraryResized"/></StackPanel>
 <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
 <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Kicker}" Text="01    /    REPLAYS"/><CheckBox x:Name="AutoBox" Content="Start the replay buffer when a selected game launches" Click="SettingsChanged"/><WrapPanel Margin="0,6,0,0"><StackPanel Margin="0,0,18,0"><TextBlock Text="Replay length" Style="{StaticResource Sub}"/><ComboBox x:Name="LengthBox" SelectionChanged="SettingsChanged"/></StackPanel><StackPanel><TextBlock Text="Save replay" Style="{StaticResource Sub}"/><Button x:Name="HotkeyButton" MinWidth="170" Margin="0" Padding="12,7" Click="ListenHotkey" ToolTip="Click, then press your shortcut"/></StackPanel></WrapPanel>
 <TextBlock x:Name="HotkeyHelp" Style="{StaticResource Sub}" Margin="0,6,0,0" Text="Click the shortcut to change it."/>
 <TextBlock Text="Games to capture" FontWeight="SemiBold" Margin="0,18,0,5"/><TextBlock Text="Select the game's executable. Moments watches for its window while open or in the tray." Style="{StaticResource Sub}"/><ListBox x:Name="GameList" MinHeight="40" MaxHeight="140" Margin="0,8,0,8"/><WrapPanel><Button Content="+   Add game" Click="AddGame"/><Button Content="Remove from list" Click="RemoveGame"/></WrapPanel></StackPanel></Border>
 <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel>
 <TextBlock Style="{StaticResource Kicker}" Text="02    /    LEAGUE OF LEGENDS AUTO-SAVE"/>
 <CheckBox x:Name="LolAutoSaveBox" Content="Automatically save replays after selected LoL events" Click="AutoSaveChanged"/>
 <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" Text="Saves the last 5 or 10 minutes, 30 seconds after the last selected event. Each new event restarts the countdown. Long fights are saved in overlapping parts before the buffer expires."/>
 <TextBlock Style="{StaticResource Sub}" Margin="0,7,0,4" TextWrapping="Wrap" Text="Add League of Legends.exe (the game, not the launcher) above and enable the replay buffer. Events apply only to your player; takedowns include your assists."/>
 <WrapPanel x:Name="LolEventOptions" Margin="0,5,0,0" IsEnabled="{Binding IsChecked,ElementName=LolAutoSaveBox}"/>
 <TextBlock x:Name="LolSettingsStatus" Style="{StaticResource Sub}" Foreground="#B7F59B" Margin="0,8,0,0" TextWrapping="Wrap"/>
 </StackPanel></Border>
 <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Style="{StaticResource Kicker}" Text="03    /    AUDIO TRACKS"/><TextBlock Style="{StaticResource Sub}" Margin="0,7" Text="Applications that play sound are added automatically, including apps started during recording. Mute individual apps in the editor."/><WrapPanel><CheckBox x:Name="SystemBox" Content="System audio" Click="SettingsChanged"/><CheckBox x:Name="MicBox" Content="Microphone" Click="SettingsChanged"/></WrapPanel><CheckBox x:Name="AppTracksBox" Content="Separate app tracks" ToolTip="One desktop audio track per application. Turn off to use the default output device as a single system mix." IsEnabled="{Binding IsChecked,ElementName=SystemBox}" Checked="SettingsChanged" Unchecked="SettingsChanged"/></StackPanel></Border>
 <Border x:Name="UpdatesCard" Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel>
 <TextBlock Style="{StaticResource Kicker}" Text="04    /    UPDATES"/>
 <TextBlock x:Name="InstalledVersion" FontWeight="SemiBold" Margin="0,8,0,4"/>
 <TextBlock x:Name="UpdateStatus" Style="{StaticResource Sub}" TextWrapping="Wrap" Text="Check for a newer Windows version on GitHub."/>
 <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Minimum="0" Maximum="100" Height="6" Margin="0,12,0,4" Foreground="{StaticResource Mint}"/>
 <WrapPanel Margin="0,12,0,0">
 <Button x:Name="CheckUpdateButton" Content="Check for updates" Click="CheckUpdateClick"/>
 <Button x:Name="DownloadUpdateButton" Content="Update and restart" Click="DownloadUpdateClick" IsEnabled="False"/>
 <Button x:Name="CancelUpdateButton" Content="Cancel" Click="CancelUpdateClick" Visibility="Collapsed"/>
 <Button x:Name="OpenUpdateButton" Content="Open download folder ↗" Click="OpenUpdateClick" Visibility="Collapsed"/>
 <Button x:Name="UpdateReleaseButton" Content="Release notes ↗" Click="UpdateReleaseClick" IsEnabled="False"/>
 </WrapPanel>
 <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,8,0,0" Text="Downloads, verifies and installs the update, then restarts Moments. Your settings and recordings are kept. Stop recording, turn off the replay buffer and close the editor before updating."/>
 </StackPanel></Border>
 </StackPanel></Grid></ScrollViewer>
 <TextBlock x:Name="Notice" Grid.Row="2" Text="Ready to record" Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis" MaxHeight="48" Margin="0,12,0,0"/>
 </Grid></Grid></Window>

