<Window x:Class="Moments.AssemblyWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Moments · Video Editor" Width="1440" Height="880" MinWidth="940" MinHeight="660" WindowStartupLocation="CenterOwner" Background="#151A20">
 <Window.Resources>
  <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="Padding" Value="9,5"/></Style>
  <Style x:Key="Tag" TargetType="TextBlock"><Setter Property="Foreground" Value="#AAB9CA"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="11"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="49"/><RowDefinition Height="3*" MinHeight="200"/><RowDefinition Height="5"/><RowDefinition Height="2*" MinHeight="205"/><RowDefinition Height="27"/></Grid.RowDefinitions>
  <Border Background="#20262D" BorderBrush="#333C44" BorderThickness="0,0,0,1" Padding="14,5">
   <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><ComboBox x:Name="Format" Width="96" Margin="0,0,8,0"/><Button x:Name="ExportButton" Background="#4559AE" BorderBrush="#667BCB" Foreground="White" Content="Export" Click="ExportClick" Margin="0" Padding="16,5"/></StackPanel>
   <StackPanel Orientation="Horizontal"><Border Width="27" Height="27" VerticalAlignment="Center" Background="#A6E2A0" CornerRadius="6"><TextBlock Text="M" FontSize="16" FontWeight="Bold" Foreground="#203326" HorizontalAlignment="Center"/></Border><TextBlock Text="VIDEO EDITOR" Style="{StaticResource Tag}" Margin="9,0,18,0"/><TextBox x:Name="ProjectName" Width="210" VerticalAlignment="Center" MaxLength="80" LostKeyboardFocus="NameChanged" KeyDown="NameKey" ToolTip="Project and export name"/></StackPanel></DockPanel></Border>
  <Grid Grid.Row="1" Margin="8,7,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="268" MinWidth="195"/><ColumnDefinition Width="5"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="#1E252C" Padding="11" AllowDrop="True" DragOver="BinDragOver" Drop="BinDrop"><DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10"><Button x:Name="ImportButton" Content="+ Import" Style="{StaticResource Small}" DockPanel.Dock="Right" Margin="0" Click="ImportClick"/><TextBlock Style="{StaticResource Tag}" Text="MEDIA BIN"/></DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,7,0,0"><Button x:Name="AppendButton" Content="＋   Append to sequence" Style="{StaticResource Small}" Margin="0" Click="AppendClick"/><TextBlock Style="{StaticResource Sub}" FontSize="11" Margin="0,6,0,0" Text="Drag a clip onto a track."/></StackPanel>
    <ListBox x:Name="Bin" BorderThickness="0" Background="#1A2026" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonDown="BinDown" PreviewMouseMove="BinMove" MouseDoubleClick="BinDoubleClick">
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#101419" Height="33" CornerRadius="3"><Image Source="{Binding Thumb}" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#A3B1C2" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel></Border>
   <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#151A20"/>
   <Grid Grid.Column="2" Background="#1D242B"><Grid.RowDefinitions><RowDefinition Height="27"/><RowDefinition/><RowDefinition Height="39"/></Grid.RowDefinitions>
    <DockPanel Margin="12,0"><TextBlock x:Name="FormatInfo" DockPanel.Dock="Right" Style="{StaticResource Tag}" FontSize="10"/><TextBlock Text="PROGRAM MONITOR" Style="{StaticResource Tag}"/></DockPanel>
    <Grid Grid.Row="1" Background="#090B0E"><Viewbox Stretch="Uniform"><Grid x:Name="ProjectFrame" Background="Black"><m:RgbVideoView xmlns:m="clr-namespace:Moments" x:Name="Monitor" Stretch="Uniform"/></Grid></Viewbox><TextBlock x:Name="MonitorHint" HorizontalAlignment="Center" Style="{StaticResource Sub}" Text="Add your first clip to the timeline"/></Grid>
    <DockPanel Grid.Row="2" Margin="9,2"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center"><Button x:Name="Play" Content="▶" Click="PlayClick" Style="{StaticResource Small}" ToolTip="Play or pause · Space" Width="40"/><Button Content="◀|" Click="BackFrame" Style="{StaticResource Small}" ToolTip="Previous frame"/><Button Content="|▶" Click="ForwardFrame" Style="{StaticResource Small}" ToolTip="Next frame"/></StackPanel><TextBlock x:Name="FrameReadout" FontFamily="Consolas" Foreground="#A9C7E2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0"/></DockPanel>
   </Grid>
  </Grid>
  <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#11161A"/>
  <Border Grid.Row="3" Background="#1E252C" Margin="8,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <DockPanel Margin="10,7,8,6"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="−" Click="ZoomOut" Style="{StaticResource Small}" ToolTip="Zoom out"/><Button x:Name="Fit" Content="Fit" Click="FitClick" Style="{StaticResource Small}"/><Button Content="+" Click="ZoomIn" Style="{StaticResource Small}" ToolTip="Zoom in"/></StackPanel>
    <WrapPanel><TextBlock Text="TIMELINE" Style="{StaticResource Tag}" Margin="0,0,12,0"/><Button x:Name="SplitButton" Content="Split · S" Style="{StaticResource Small}" Click="SplitClick"/><Button x:Name="UnlinkButton" Content="Unlink" Style="{StaticResource Small}" Click="UnlinkClick"/><Button x:Name="DeleteButton" Content="Remove" ToolTip="Remove clip · Delete" Style="{StaticResource Small}" Click="DeleteClick"/><Button x:Name="UndoButton" Content="↶" Click="UndoClick" Style="{StaticResource Small}" ToolTip="Undo · Ctrl+Z"/><Button x:Name="RedoButton" Content="↷" Click="RedoClick" Style="{StaticResource Small}" ToolTip="Redo · Ctrl+Y"/><Button Content="+ V" Click="AddVideoLane" Style="{StaticResource Small}" ToolTip="Add video track"/><Button Content="+ A" Click="AddAudioLane" Style="{StaticResource Small}" ToolTip="Add audio track"/><Button Content="Clear" Click="ClearClick" Style="{StaticResource Small}" ToolTip="Clear the timeline. Use Undo to restore it."/></WrapPanel>
   </DockPanel>
   <ScrollViewer x:Name="VerticalTracks" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel x:Name="Headers" Background="#202830"/>
     <ScrollViewer x:Name="TrackScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" ScrollChanged="TimelineScroll"><Canvas x:Name="TimelineCanvas" Background="#171D23" ClipToBounds="True" AllowDrop="True" DragEnter="TimelineDragEnter" DragLeave="TimelineDragLeave" DragOver="TimelineDragOver" Drop="TimelineDrop" MouseLeftButtonDown="TimelineDown" MouseMove="TimelineMove" MouseLeftButtonUp="TimelineUp" LostMouseCapture="CaptureLost" MouseLeave="TimelineLeave"/></ScrollViewer>
   </Grid></ScrollViewer>
  </Grid></Border>
  <TextBlock x:Name="Status" Grid.Row="4" Margin="14,0" VerticalAlignment="Center" FontSize="11" Foreground="#AEBAC6" TextTrimming="CharacterEllipsis"/>
 </Grid>
</Window>
