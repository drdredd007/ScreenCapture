<Window x:Class="Moments.GamePicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Moments · Choose Game" Width="800" Height="550" MinWidth="620" MinHeight="420" WindowStartupLocation="CenterOwner">
<Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock x:Name="Category" Style="{StaticResource Kicker}" Text="MOMENTS   /   GAMES"/><TextBlock x:Name="Heading" Style="{StaticResource H2}" Text="Choose a game" Margin="0,4"/><TextBlock x:Name="Description" Style="{StaticResource Sub}" Text="Select a running game or browse to its executable."/></StackPanel>
 <WrapPanel Grid.Row="1" Margin="0,14,0,10"><Button x:Name="RunningButton" Content="Running windows" Click="RunningClick"/><Button x:Name="FilesButton" Content="Browse files" Click="FilesClick"/></WrapPanel>
 <DockPanel x:Name="PathRow" Grid.Row="2" Margin="0,0,0,8"><Button Content="↑" ToolTip="Up one folder" DockPanel.Dock="Left" Click="UpClick"/><Button Content="Go" DockPanel.Dock="Right" Click="PathClick" Margin="6,0,0,0"/><TextBox x:Name="Location" KeyDown="PathKey" ToolTip="Folder or full path to an .exe file"/></DockPanel>
 <ListBox x:Name="Entries" Grid.Row="3" MouseDoubleClick="ChooseDoubleClick" KeyDown="ListKey" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
 <DockPanel Grid.Row="4" Margin="0,12,0,0"><Button Content="Select" Style="{StaticResource Accent}" DockPanel.Dock="Right" Click="ChooseClick" Margin="8,0,0,0"/><Button Content="Cancel" DockPanel.Dock="Right" IsCancel="True" Margin="0"/><TextBlock x:Name="Hint" Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis" MaxHeight="38"/></DockPanel>
</Grid></Window>
