<Window x:Class="Moments.Editor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Moments · Clip Editor" Width="1440" Height="842" MinWidth="940" MinHeight="610" Background="#191F24" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <SolidColorBrush x:Key="BlueInk" Color="#C0C9EF"/>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#BDC9DB"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="11"/></Style>
  <Style x:Key="Field" TargetType="TextBlock" BasedOn="{StaticResource Sub}"><Setter Property="Foreground" Value="#91A0B4"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,9,0,4"/></Style>
  <Style x:Key="Tool" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="Background" Value="#2B343F"/><Setter Property="BorderBrush" Value="#394451"/><Setter Property="Foreground" Value="#DDE4F2"/></Style>
  <Style x:Key="Rule" TargetType="Border"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="#313943"/><Setter Property="Margin" Value="0,16"/></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/><RowDefinition Height="24"/></Grid.RowDefinitions>
 <Border Background="#20272D" Padding="15,0"><DockPanel><TextBlock Text="MOMENTS   /   CLIP EDITOR" DockPanel.Dock="Left" Style="{StaticResource Section}" Margin="0,0,20,0"/><Button DockPanel.Dock="Right" Click="AssemblyClick" Style="{StaticResource Tool}" VerticalAlignment="Center" Content="＋ Add source to timeline" ToolTip="Append the original clip to the multitrack project"/><TextBlock x:Name="FileTitle" Foreground="#BBC5D3" FontSize="13" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
 <Grid Grid.Row="1" Margin="12,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="292"/></Grid.ColumnDefinitions>
  <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="#0B0E10" CornerRadius="3" ClipToBounds="True"><m:RgbVideoView xmlns:m="clr-namespace:Moments" x:Name="Video" Stretch="Uniform"/></Border>
   <Border Grid.Row="1" Background="#20272E" Margin="0,7,0,0" Padding="12,9,12,12" CornerRadius="3"><StackPanel>
    <DockPanel LastChildFill="True" Margin="0,0,0,5"><TextBlock x:Name="PositionText" DockPanel.Dock="Right" FontFamily="Consolas" FontSize="12" Foreground="#CDD7ED" Margin="8,0,0,0"/><WrapPanel>
     <Button x:Name="PlayButton" Style="{StaticResource Tool}" Content="▶   Play" Click="PlayClick" Background="#384760"/>
     <Button Content="A   Mark in" Style="{StaticResource Tool}" Click="SetA"/><Button Content="B   Mark out" Style="{StaticResource Tool}" Click="SetB"/>
     <Button Content="Cut A–B" Style="{StaticResource Tool}" Click="RemoveAB"/><Button Content="Keep only A–B" Style="{StaticResource Tool}" Click="KeepAB"/>
    </WrapPanel></DockPanel>
    <Grid Height="26"><Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="TRACKS" Style="{StaticResource Section}" FontSize="9" Foreground="#98A8BC"/>
     <Grid Grid.Column="1"><Slider x:Name="Timeline" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" ValueChanged="Scrub" ToolTip="Playback position" Opacity=".72"/></Grid>
    </Grid>
    <ScrollViewer MaxHeight="172" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="LaneArea"><StackPanel><Grid Height="32"><Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TextBlock Text="▸   Video" FontWeight="SemiBold" Foreground="#BFCBD9" FontSize="12"/>
      <Canvas x:Name="CutBar" Grid.Column="1" Background="#2A333C" ClipToBounds="True" SizeChanged="BarResized" MouseLeftButtonDown="RangeDown" MouseMove="RangeMove" MouseLeftButtonUp="RangeUp" ToolTip="Click to seek. Drag a teal A or B handle to adjust the range."/>
     </Grid><StackPanel x:Name="AudioPanel"/></StackPanel>
     <Canvas x:Name="PlayheadOverlay" Margin="128,0,0,0" ClipToBounds="True" IsHitTestVisible="False"><Border x:Name="Playhead" Width="1.5" Height="{Binding ActualHeight,ElementName=LaneArea}" Background="#E4F0FF"/></Canvas>
    </Grid></ScrollViewer>
    <DockPanel Margin="0,7,0,0"><TextBlock x:Name="Markers" Foreground="#98B6BE" FontSize="11" DockPanel.Dock="Right" FontFamily="Consolas"/><TextBlock Text="Drag the A and B handles to set the range" Style="{StaticResource Sub}" FontSize="11"/></DockPanel>
   </StackPanel></Border>
  </Grid>
  <Border Grid.Column="2" Background="#1D242A" Padding="18,17,18,10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <Button x:Name="ExportButton" Height="40" Content="Export" Click="ExportClick" Background="#475BBC" BorderBrush="#6274CB" Foreground="White" Margin="0,0,0,12"/>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,3,0">
    <TextBlock Text="CLIP SETTINGS" Style="{StaticResource Section}"/><TextBlock Text="Export name" Style="{StaticResource Field}"/><TextBox x:Name="OutputName" MaxLength="80"/>
    <TextBlock Text="Format" Style="{StaticResource Field}"/><ComboBox x:Name="FormatBox"/><TextBlock x:Name="ResultLength" TextWrapping="Wrap" Foreground="#B6C8DD" Margin="0,9,0,0" FontSize="12"/>
    <Border Style="{StaticResource Rule}"/><TextBlock Text="CUTS" Style="{StaticResource Section}"/><TextBlock x:Name="CutHint" Style="{StaticResource Field}" Text="Set markers A and B to select a range."/>
    <ListBox x:Name="CutList" MaxHeight="106" BorderThickness="0" Visibility="Collapsed"/><Button x:Name="RestoreCut" Content="Restore selected cut" Style="{StaticResource Tool}" Margin="0,6,0,0" Click="UndoCut" Visibility="Collapsed"/>
    <Border Style="{StaticResource Rule}"/><TextBlock Text="FILE DETAILS" Style="{StaticResource Section}"/><TextBlock Text="Created" Style="{StaticResource Field}"/><TextBlock x:Name="CreatedText" FontSize="13"/>
    <TextBlock Text="Video" Style="{StaticResource Field}"/><TextBlock x:Name="FileMeta" FontSize="13" TextWrapping="Wrap"/>
    <TextBlock Text="Size" Style="{StaticResource Field}"/><TextBlock x:Name="FileSizeText" FontSize="13"/>
    <TextBlock Text="Location" Style="{StaticResource Field}"/><TextBlock x:Name="SourcePath" Foreground="#AEBACB" FontSize="12" TextWrapping="Wrap"/>
   </StackPanel></ScrollViewer>
  </Grid></Border>
 </Grid>
 <TextBlock x:Name="Feedback" Grid.Row="2" Foreground="#95A4B5" FontSize="11" Margin="14,0" Text="Preparing preview…" TextTrimming="CharacterEllipsis"/>
 </Grid>
</Window>
